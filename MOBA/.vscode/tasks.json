{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Re-generate Map API",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"dotnet build '${workspaceFolder}/../Realm/Realm.MapAPI/Realm.MapAPI.csproj' && cp '${workspaceFolder}/../Realm/Realm.MapAPI/bin/Debug/net10.0/Realm.MapAPI.'* '${workspaceFolder}/lib/'"
			],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Builds Realm.MapAPI from the sibling Realm/ clone and copies DLL, XML, and PDB into MOBA/lib."
		}
	]
}
